instance/
mail-receive-api/instance/
*.sqlite
*.sqlite3

# Runtime Application Logs
logs/
*.log
mail-receive-api/logs/

# Candidate Internal Archives & Raw Prompts (Archived locally, excluded from repository)
archive/

