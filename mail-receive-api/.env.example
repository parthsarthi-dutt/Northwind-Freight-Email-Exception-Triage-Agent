# Flask Server Configuration
PORT=5000
FLASK_DEBUG=true
SECRET_KEY=shipsy-secret-key-change-in-production

# SQLite Database Path (Optional, defaults to instance/emails.db)
# DATABASE_PATH=instance/emails.db

# Real Gmail Configuration (IMAP)
# 1. Enable 2-Step Verification in Google Account: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
#    Select app: 'Mail', device: 'Other (Ships Mail Agent)'
# 3. Enter your Gmail and the 16-character generated password below:
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Webhook Forward Target (used by the push agent to notify your webhook endpoint in real-time)
WEBHOOK_LOCAL_URL=http://127.0.0.1:5000/webhook/email

# Redis Stream Configuration (Decoupled Agentic Workflow Queue)
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_NAME=email:stream
REDIS_CONSUMER_GROUP=agentic_workflow_group

